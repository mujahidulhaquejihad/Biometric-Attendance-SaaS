DATABASE_URL=postgresql://attendance:attendance@localhost:5432/attendance
BETTER_AUTH_SECRET=change-me-to-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
# 32 random bytes, base64. Derives per-tenant AES-256-GCM keys for biometric templates and device secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
# Optional. Without it, emails are printed to the server log.
SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM=Attendance <no-reply@example.com>
# Comma-separated emails that become platform super admins on sign-up.
SUPER_ADMIN_EMAILS=
# Set to "off" to run a web-only instance without background workers.
JOBS=on
